/* ── FIO 진단 구조체 — C#에서 OspBridge_GetFioDiag()로 읽음 ── */
typedef struct
{
    /* FIO0 각 단계 status (0=성공, 그 외=실패코드) */
    int nFio0Open;
    int nFio0Callback;
    int nFio0InstRAM;
    int nFio0ResetQueue;  /* ★ adi_eal_fioOspResetQueue 결과 */
    int nFio0Reset;
    int nFio0InitBidir;
    int nFio0AssignedAddr;
    int nFio0SetSetup;
    int nFio0SetState;
    /* FIO1 각 단계 status */
    int nFio1Open;
    int nFio1Callback;
    int nFio1InstRAM;
    int nFio1ResetQueue;  /* ★ adi_eal_fioOspResetQueue 결과 */
    int nFio1Reset;
    int nFio1InitBidir;
    int nFio1AssignedAddr;
    int nFio1SetSetup;
    int nFio1SetState;
    /* 핸들 NULL 여부 (0=NULL, 1=유효) */
    int nFio0HandleValid;
    int nFio1HandleValid;
} OSP_FIO_DIAG;

