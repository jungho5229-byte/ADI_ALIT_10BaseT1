  <!-- ================================================================
       NativeOsp / OspBridge.dll 자동 빌드
       - cmake-build 폴더 삭제 후 항상 fresh configure + build
       - 폴더를 어디로 옮겨도 CMakeCache.txt 경로 불일치 오류 없음
       ================================================================ -->
  <!-- Step 1: cmake-build 폴더 통째로 삭제 (경로 하드코딩 제거) -->
  <Target Name="CleanCMakeBuildDir" BeforeTargets="ConfigureOspBridge">
    <RemoveDir Directories="$(MSBuildProjectDirectory)\NativeOsp\cmake-build" Condition="Exists('$(MSBuildProjectDirectory)\NativeOsp\cmake-build')" />
    <MakeDir Directories="$(MSBuildProjectDirectory)\NativeOsp\cmake-build" />
  </Target>
  <!-- Step 2: cmake configure (항상 실행) -->
  <Target Name="ConfigureOspBridge" BeforeTargets="BuildOspBridge">
    <Message Text="[NativeOsp] cmake configure..." Importance="high" />
    <Exec Command="cmake -S &quot;$(MSBuildProjectDirectory)\NativeOsp&quot; -B &quot;$(MSBuildProjectDirectory)\NativeOsp\cmake-build&quot; -G Ninja" WorkingDirectory="$(MSBuildProjectDirectory)\NativeOsp\cmake-build" />
  </Target>
  <!-- Step 3: cmake build -->
  <Target Name="BuildOspBridge" BeforeTargets="BeforeBuild">
    <Message Text="[NativeOsp] cmake build..." Importance="high" />
    <Exec Command="cmake --build &quot;$(MSBuildProjectDirectory)\NativeOsp\cmake-build&quot;" WorkingDirectory="$(MSBuildProjectDirectory)\NativeOsp\cmake-build" />
  </Target>
  <!-- Step 4: OspBridge.dll → bin 출력 폴더로 복사 -->
  <Target Name="CopyOspBridge" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)\NativeOsp\build\OspBridge.dll')">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\NativeOsp\build\OspBridge.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
